# User unit (systemctl --user). Serves the built front end (dist/). Rebuild with:
#   VITE_COLYSEUS_URL=ws://10.20.0.117:2567 npm run build
# The room server address is baked in at build time, so it must be reachable from players' browsers.
[Unit]
Description=MTG Board web app (built dist)
After=network.target mtg-board-server.service

[Service]
WorkingDirectory=%h/mtg-board-layout
ExecStart=/usr/bin/node node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 4173 --strictPort
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
